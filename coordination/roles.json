{
  "schema_version": "0.2",
  "note": "Default scopes describe ownership; each run receives a narrower, explicit task scope. They are not OS sandbox rules.",
  "roles": [
    {
      "id": "lead",
      "name": "项目协调",
      "model_alias": "gpt6.2astra",
