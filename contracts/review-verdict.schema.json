{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:menubar-agent:v0.2:ReviewVerdict",
  "title": "ReviewVerdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "review_id",
    "task_id",
    "author_attempt_id",
    "author_run_id",
    "reviewer_run_id",
    "reviewer_principal_id",
    "task_spec_sha256",
    "contract_sha",
    "reviewed_base_sha",
    "reviewed_head_sha",
    "verdict",
    "summary",
    "findings",
    "coverage",
    "evidence_refs",
    "worker_result_ref",
    "reviewer_manifest_ref",
    "effective_model_id",
    "issued_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "record_type": {
      "const": "ReviewVerdict"
    },
    "review_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^(OPS|APP)-[0-9]{2}(?:-[A-Z0-9]+)?$"
    },
    "author_attempt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "author_run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "reviewer_run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "reviewer_principal_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "task_spec_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contract_sha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "reviewed_base_sha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "reviewed_head_sha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "verdict": {
      "enum": [
        "approved",
        "changes_requested",
        "blocked",
        "unknown"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "severity",
          "blocking",
          "status",
          "description",
          "evidence_refs"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "severity": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3",
              "info"
            ]
          },
          "blocking": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "open",
              "resolved"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\x00\\r\\n:]+$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "minItems": 1
          }
        }
      },
      "minItems": 0
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checked",
        "not_checked"
      ],
      "properties": {
        "checked": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "not_checked": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\x00\\r\\n:]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "minItems": 0
    },
    "worker_result_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\x00\\r\\n:]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "reviewer_manifest_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\x00\\r\\n:]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "effective_model_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?Z$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "approved"
          }
        }
      },
      "then": {
        "properties": {
          "evidence_refs": {
            "minItems": 1
          },
          "findings": {
            "not": {
              "contains": {
                "type": "object",
                "required": [
                  "blocking",
                  "status"
                ],
                "properties": {
                  "blocking": {
                    "const": true
                  },
                  "status": {
                    "const": "open"
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "description": "Immutable review of exact source and contract. Independence, reviewer authorization, matching author result, and current source bindings must be checked by the coordinator; this JSON cannot authenticate itself."
}
